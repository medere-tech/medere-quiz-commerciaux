# Firebase — projet DÉDIÉ à cette application.
# Ne pas mutualiser : le quota gratuit Firestore se compte au niveau du projet
# et ne couvre qu'une seule base.
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=

# Firebase Admin — serveur uniquement, jamais exposé au navigateur
FIREBASE_ADMIN_PROJECT_ID=
FIREBASE_ADMIN_CLIENT_EMAIL=
FIREBASE_ADMIN_PRIVATE_KEY=

# Airtable — LECTURE SEULE.
# Jeton créé avec les seuls scopes data.records:read et schema.bases:read,
# restreint à la base formations. Aucun scope d'écriture.
AIRTABLE_TOKEN=
AIRTABLE_BASE_ID=
AIRTABLE_TABLE_FORMATIONS=

# App Check — reCAPTCHA Enterprise. Obligatoire.
# La clé de site est publique par construction : elle apparaît dans le code de
# la page. Sans elle, l'application ne démarre pas : aucune requête ne doit
# partir sans jeton d'attestation. Procédure : README, section 4.
NEXT_PUBLIC_RECAPTCHA_ENTERPRISE_SITE_KEY=
# Jeton de débogage, pour le développement local uniquement. Seule variable
# App Check facultative : laisser vide pour que le SDK en génère un et
# l'affiche dans la console du navigateur. La renseigner sert à figer le même
# jeton entre plusieurs machines. Sans effet en production.
NEXT_PUBLIC_APPCHECK_DEBUG_TOKEN=

# Accès
ALLOWED_EMAIL_DOMAIN=
ADMIN_EMAILS=
