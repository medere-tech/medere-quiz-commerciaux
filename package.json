{
  "name": "medere-quiz-commerciaux",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=20.9.0"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit && npm --prefix functions run typecheck",
    "test": "npm run test:regles",
    "test:regles": "firebase emulators:exec --only firestore --project demo-medere-quiz \"vitest run\"",
    "emulateurs": "firebase emulators:start --only firestore --project demo-medere-quiz",
    "regles:deploy": "firebase deploy --only firestore:rules && npm run regles:verifier",
    "index:verifier": "node --env-file=.env.local scripts/verifier-index.ts",
    "stats:reprise": "node --env-file=.env.local scripts/agreger-historique.ts",
    "etats:reprise": "node --env-file=.env.local scripts/reconstruire-etats.ts",
    "enonces:normaliser": "node --env-file=.env.local scripts/normaliser-enonces.ts",
    "regles:verifier": "node --env-file=.env.local scripts/verifier-regles.ts"
  },
  "dependencies": {
    "firebase": "12.18.0",
    "firebase-admin": "14.3.0",
    "next": "16.3.4",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "read-excel-file": "^9.3.10",
    "server-only": "0.0.1"
  },
  "devDependencies": {
    "@firebase/rules-unit-testing": "5.0.2",
    "@types/node": "26.4.0",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.4",
    "eslint": "9.39.1",
    "eslint-config-next": "16.3.4",
    "firebase-tools": "15.28.2",
    "typescript": "5.9.3",
    "vitest": "4.1.11"
  }
}
