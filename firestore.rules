rules_version = '2';

// Règles de sécurité — application d'entraînement des commerciaux Médéré.
// Référence : README.md, section 4. Toute modification passe par les tests
// d'émulateur (`npm test`) avant déploiement. Jamais de mode test.
//
// Les règles répondent à deux questions : qui écrit, et quoi. La validation
// de forme n'est pas un doublon de la validation applicative — c'est la
// seule qui tienne face à un client modifié ou à un import mal formé.
//
// Les plafonds de longueur sont justifiés un à un dans le README, section 4,
// « Plafonds de longueur ». Ils ne sont pas décoratifs : sans eux, une seule
// écriture peut approcher le document maximal d'un mégaoctet, faire enfler
// les index et alourdir chaque lecture ultérieure.

service cloud.firestore {
  match /databases/{database}/documents {

    // --- Identité --------------------------------------------------------

    // Le domaine est écrit en dur : les règles n'ont pas accès aux variables
    // d'environnement. Il doit rester aligné sur ALLOWED_EMAIL_DOMAIN
    // (voir src/lib/auth/domaine.ts, qui porte la même valeur côté serveur).
    function domaineAutorise() {
      return request.auth != null
        && request.auth.token.get('email_verified', false) == true
        && request.auth.token.get('email', '') is string
        && request.auth.token.get('email', '').lower().matches('^[^@]+@medere[.]fr$');
    }

    // Le rôle administrateur est un custom claim, jamais un champ Firestore.
    function estAdmin() {
      return domaineAutorise() && request.auth.token.get('admin', false) == true;
    }

    function estProprietaire(uid) {
      return domaineAutorise() && request.auth.uid == uid;
    }

    function estAnimateur(sessionId) {
      return estAdmin()
        && get(/databases/$(database)/documents/sessions/$(sessionId)).data.animateurUid == request.auth.uid;
    }

    // --- Outils de forme -------------------------------------------------

    // Texte obligatoire, non réduit à des espaces, et borné.
    function texteBorne(valeur, maximum) {
      return valeur is string && valeur.trim().size() > 0 && valeur.size() <= maximum;
    }

    // Texte facultatif : la chaîne vide est acceptée, la longueur non.
    // Airtable laisse des sélections simples sans valeur ; refuser la
    // formation entière pour un format non renseigné la ferait disparaître du
    // catalogue, ce qui est pire que de la montrer sans son format.
    function texteFacultatifBorne(valeur, maximum) {
      return valeur is string && valeur.size() <= maximum;
    }

    // Identifiant technique. 128 caractères est la longueur maximale d'un uid
    // Firebase Authentication ; les identifiants Firestore générés en font 20.
    function identifiantBorne(valeur) {
      return valeur is string && valeur.size() > 0 && valeur.size() <= 128;
    }

    // Les règles ne savent pas parcourir une liste pour mesurer chaque
    // élément. La concaténation borne l'ensemble d'un seul test, ce qui
    // suffit : c'est le volume cumulé qui pèse sur le document et les index.
    function listeBornee(liste, maximumCumule) {
      return liste is list && liste.join(',').size() <= maximumCumule;
    }

    function sansDoublon(liste) {
      return liste is list && liste.toSet().size() == liste.size();
    }

    // Deux listes décrivent le même ensemble de réponses.
    function memesElements(gauche, droite) {
      return gauche.hasAll(droite) && gauche.hasOnly(droite);
    }

    function horodatagePasse(valeur) {
      return valeur is timestamp && valeur <= request.time;
    }

    // --- Référentiel : formations ----------------------------------------
    // Lecture par tout utilisateur authentifié du domaine, écriture réservée
    // au custom claim administrateur. En production, la collection est tenue
    // par la synchronisation Airtable, qui passe par le SDK Admin et n'est
    // donc pas soumise à ces règles : elles couvrent la retouche manuelle.

    // Modèle fixé par docs/airtable-formations.md, qui fait foi : `cibles` est
    // une liste, pas une chaîne, parce que « Public concerné » est une
    // sélection multiple côté Airtable.
    function champsFormation() {
      return ['airtableId', 'numeroActionDpc', 'nom', 'cibles', 'format',
              'modalite', 'blocsCertification', 'dureeTotale', 'urlWebflow',
              'actif', 'syncLe'];
    }

    function formationValide(donnees) {
      return donnees.keys().hasOnly(champsFormation())
        && donnees.keys().hasAll(champsFormation())
        // Identité : sans ces trois-là, la formation n'est pas rapprochable.
        && texteBorne(donnees.airtableId, 64)
        && texteBorne(donnees.numeroActionDpc, 60)
        && texteBorne(donnees.nom, 200)
        // Descriptif : Airtable peut les laisser vides.
        && texteFacultatifBorne(donnees.format, 60)
        && texteFacultatifBorne(donnees.modalite, 60)
        && texteFacultatifBorne(donnees.dureeTotale, 60)
        && texteFacultatifBorne(donnees.urlWebflow, 500)
        && donnees.cibles is list
        && sansDoublon(donnees.cibles)
        && listeBornee(donnees.cibles, 500)
        && donnees.blocsCertification is list
        && sansDoublon(donnees.blocsCertification)
        && listeBornee(donnees.blocsCertification, 200)
        && donnees.actif is bool
        && horodatagePasse(donnees.syncLe);
    }

    match /formations/{formationId} {
      allow read: if domaineAutorise();
      allow create, update: if estAdmin() && formationValide(request.resource.data);
      allow delete: if estAdmin();
    }

    // --- Référentiel : questions -----------------------------------------
    // Les mêmes contraintes s'appliquent à la saisie unitaire du back-office
    // et à l'import en masse : l'import écrit par le même chemin, il ne
    // dispose d'aucune dérogation.
    //
    // `options` est une map { identifiant: libellé } et `ordreOptions` la
    // liste qui fixe l'affichage. Cette forme permet de valider l'ensemble
    // des identifiants sans les énumérer, donc sans plafonner leur nombre.
    // Ce que les règles ne savent pas faire : parcourir les valeurs de la
    // map pour vérifier que chaque libellé est une chaîne non vide et bornée.
    // Ce contrôle appartient à la validation serveur de l'import, lot 4.

    function champsQuestion() {
      return ['type', 'contexte', 'enonce', 'options', 'ordreOptions', 'bonnesReponses',
              'explication', 'formationIds', 'theme', 'difficulte', 'statut',
              'creeeLe', 'modifieeLe', 'creeePar'];
    }

    // Forme normalisée de l'énoncé, dérivée et jamais saisie : elle sert la
    // détection de doublons, que Firestore ne sait faire que sur une égalité
    // exacte. Facultative dans les règles — les questions écrites avant sa
    // mise en service n'en portent pas, et l'exiger casserait leur prochaine
    // mise à jour. **Ce que les règles ne vérifient pas :** qu'elle
    // corresponde vraiment à l'énoncé. Elles ne savent ni décomposer les
    // accents ni appliquer une expression régulière. Une valeur fausse ne
    // dégrade que la détection de doublons, un avertissement d'import.
    //
    // Traçabilité de la fiche d'argumentaire : facultative, et elle doit le
    // rester. L'exiger reviendrait à supposer que toute fiche porte un numéro
    // de version — vrai de la trame d'aujourd'hui, pas du produit. Le jour où
    // la trame change, l'application bloquerait pour une raison qui ne la
    // regarde pas. Absents ou vides, ces champs passent ; renseignés, ils
    // sont bornés comme les autres.
    /*
     * L'angle de vente et la signature de l'explication sont **facultatifs**,
     * et pour deux raisons différentes.
     *
     * L'argumentaire, parce qu'une question de fait n'en a pas : en exiger un
     * produirait du remplissage, et le remplissage apprend au commercial à
     * sauter la carte.
     *
     * La signature, parce que les questions écrites avant ce lot n'en portent
     * pas — et **la raison n'est pas de ménager les données existantes**, qui
     * sont de la recette : c'est qu'une signature s'acquiert en écrivant. Une
     * question importée depuis une fiche n'a personne à créditer tant que
     * Noémie n'y a pas touché.
     */
    function champsQuestionFacultatifs() {
      return ['sourceFiche', 'sourceVersion', 'enonceNormalise',
              'argumentaire', 'explicationAuteur', 'explicationMajLe'];
    }

    function questionValide(donnees) {
      return donnees.keys().hasOnly(champsQuestion().concat(champsQuestionFacultatifs()))
        && donnees.keys().hasAll(champsQuestion())
        && donnees.type in ['vf', 'qcm', 'scenario']
        && texteBorne(donnees.enonce, 500)
        && texteBorne(donnees.explication, 1000)
        && texteBorne(donnees.theme, 60)
        && donnees.statut in ['brouillon', 'aRelire', 'publiee']
        && donnees.difficulte in [1, 2, 3]
        && donnees.formationIds is list
        && donnees.formationIds.size() > 0
        && sansDoublon(donnees.formationIds)
        && listeBornee(donnees.formationIds, 1000)
        // Une question offre au moins deux options ; au-delà, aucun plafond.
        && donnees.options is map
        && donnees.options.size() >= 2
        && listeBornee(donnees.options.keys(), 2000)
        // L'ordre d'affichage décrit exactement les options : sans oubli,
        // sans intrus, sans répétition.
        //
        // Son plafond cumulé est redondant par construction : `ordreOptions`
        // porte exactement les clés d'`options`, donc dépasser 2000 caractères
        // ici suppose de les avoir d'abord dépassés ligne au-dessus. Aucun test
        // ne peut le couvrir seul — il n'existe pas de document qui le viole
        // sans violer l'autre d'abord. Il reste écrit pour que la contrainte
        // survive à une modification future des deux règles voisines.
        && donnees.ordreOptions is list
        && listeBornee(donnees.ordreOptions, 2000)
        && donnees.ordreOptions.size() == donnees.options.size()
        && donnees.ordreOptions.toSet() == donnees.options.keys().toSet()
        && donnees.bonnesReponses is list
        && donnees.bonnesReponses.size() > 0
        && sansDoublon(donnees.bonnesReponses)
        && listeBornee(donnees.bonnesReponses, 1000)
        && donnees.bonnesReponses.toSet().hasOnly(donnees.options.keys().toSet())
        // Le contexte n'existe que pour les mises en situation.
        && (donnees.type == 'scenario'
              ? texteBorne(donnees.contexte, 1000)
              : donnees.contexte == null)
        // Traçabilité de la source, facultative : absente ou vide, elle
        // passe ; renseignée, elle est bornée comme le reste. Une question
        // qui la porte se retrouve d'une requête le jour où sa fiche change.
        && (!('enonceNormalise' in donnees) || texteFacultatifBorne(donnees.enonceNormalise, 500))
        && (!('sourceFiche' in donnees) || texteFacultatifBorne(donnees.sourceFiche, 200))
        && (!('sourceVersion' in donnees) || texteFacultatifBorne(donnees.sourceVersion, 40))
        /*
         * L'angle de vente et la signature de l'explication.
         *
         * **Tous trois facultatifs, et pour des raisons différentes.**
         * L'argumentaire l'est parce qu'une question de fait n'en a pas — en
         * exiger un produirait du remplissage. La signature l'est parce que
         * les questions écrites avant ce lot n'en portent pas, et qu'exiger
         * une signature qu'on n'a pas casserait leur prochain enregistrement.
         */
        && (!('argumentaire' in donnees) || texteFacultatifBorne(donnees.argumentaire, 600))
        && (!('explicationAuteur' in donnees)
              || texteFacultatifBorne(donnees.explicationAuteur, 60))
        && (!('explicationMajLe' in donnees) || horodatagePasse(donnees.explicationMajLe))
        && identifiantBorne(donnees.creeePar)
        && horodatagePasse(donnees.creeeLe)
        && horodatagePasse(donnees.modifieeLe);
    }

    /*
     * La date de l'explication ne bouge que si l'explication bouge.
     *
     * **C'est une garantie, pas une politesse du client.** L'écran du
     * commercial annonce « mise à jour le… » juste à côté de l'explication :
     * si une correction de virgule faisait avancer cette date, elle
     * n'apprendrait plus rien. `modifieeLe`, lui, suit chaque enregistrement —
     * c'est ce qui classe la banque, et c'est son rôle.
     *
     * La comparaison porte sur le texte exact : les règles ne savent pas
     * normaliser les espaces, et une écriture qui ne changerait que ceux-là
     * serait refusée si elle bougeait la date. Le client, lui, ne la bouge pas
     * dans ce cas — les deux se rejoignent sur le cas qui compte.
     */
    function signatureCoherente(avant, apres) {
      return (avant.explication == apres.explication
              && avant.get('argumentaire', '') == apres.get('argumentaire', ''))
        ? avant.get('explicationMajLe', null) == apres.get('explicationMajLe', null)
        : true;
    }

    match /questions/{questionId} {
      allow read: if domaineAutorise();
      allow create: if estAdmin()
        && questionValide(request.resource.data)
        && request.resource.data.creeePar == request.auth.uid;
      allow update: if estAdmin()
        && questionValide(request.resource.data)
        && request.resource.data.creeePar == resource.data.creeePar
        && request.resource.data.creeeLe == resource.data.creeeLe
        && signatureCoherente(resource.data, request.resource.data);
      allow delete: if estAdmin();
    }

    // --- Utilisateurs ----------------------------------------------------
    // Propriétaire uniquement, aucune exception administrateur.
    // Le document est créé et tenu à jour par le serveur (SDK Admin, qui
    // contourne ces règles). Le client ne peut toucher qu'à sa progression :
    // il ne peut ni s'attribuer un rôle, ni changer son adresse, ni inventer
    // un champ, ni s'offrir des étoiles qu'il n'a pas gagnées.
    //
    // Aucun plafond de longueur ici : les seuls champs modifiables par le
    // client sont deux entiers et un horodatage. Les chaînes du document
    // (email, nom, photoURL, role) ne lui sont pas accessibles en écriture.

    function champsUtilisateur() {
      return ['email', 'nom', 'photoURL', 'role',
              'etoiles', 'seriesTerminees', 'creeLe', 'vuLe', 'nomSession',
              'avatar', 'presence', 'assiduite', 'recompenses'];
    }

    function majUtilisateurAutorisee() {
      let avant = resource.data;
      let apres = request.resource.data;
      return apres.keys().hasOnly(champsUtilisateur())
        && apres.diff(avant).affectedKeys().hasOnly(
             ['etoiles', 'seriesTerminees', 'vuLe', 'nomSession', 'avatar',
              'presence', 'assiduite', 'recompenses'])
        /*
         * Le dernier lieu déclaré — en salle ou en visio —, proposé d'emblée à
         * la séance suivante. Comme le nom et la couleur : un réglage qu'il
         * faudrait penser à ouvrir avant le jeudi ne serait jamais ouvert.
         * Facultatif, parce que les comptes existants ne le portent pas.
         */
        && (!apres.keys().hasAny(['presence']) || apres.presence in ['salle', 'visio'])
        // Une teinte de la palette, et rien d'autre. La liste est fermée ici
        // pour qu'un avatar inconnu ne se glisse pas dans un écran projeté.
        && apres.avatar in ['bleu', 'turquoise', 'vert', 'jaune',
                            'orange', 'rose', 'violet', 'encre']
        /*
         * Le nom sous lequel on apparaît au classement d'une séance, et
         * nulle part ailleurs. Il vaut le nom réel par défaut ; chacun peut
         * le changer.
         *
         * **Trente-deux caractères.** Ce nom s'affiche sur un écran projeté
         * devant une salle : au-delà, il déborde ou il réduit tous les autres.
         * La borne n'est pas une précaution technique, c'est une contrainte de
         * lisibilité.
         */
        && nomAffichageValide(apres.nomSession)
        // Une série complète rapporte de zéro à trois étoiles, jamais plus,
        // et le compteur ne redescend pas.
        && apres.etoiles is int
        && apres.etoiles >= avant.etoiles
        && apres.etoiles - avant.etoiles <= 3
        // Une écriture close au plus une série.
        && apres.seriesTerminees is int
        && apres.seriesTerminees >= avant.seriesTerminees
        && apres.seriesTerminees - avant.seriesTerminees <= 1
        && horodatagePasse(apres.vuLe)
        && assiduiteValide(avant, apres)
        && recompensesValides(avant, apres);
    }

    /*
     * Les récompenses : les paliers franchis, et le jour où ils l'ont été.
     *
     * **Rien ne s'y retire ni ne s'y réécrit.** Une récompense obtenue est un
     * fait du passé : la reprendre serait pire que ne jamais l'accorder, et
     * réécrire sa date effacerait le jour où elle a été gagnée. C'est la
     * garantie qui justifie de stocker plutôt que de dériver — sans elle,
     * autant tout recalculer à chaque affichage.
     *
     * **Le plafond borne la croissance**, et c'est son seul rôle. Les neuf
     * identifiants ne sont **pas** figés ici, contrairement aux avatars : les
     * inscrire dans les règles imposerait un déploiement de règles à chaque
     * palier ajouté, avec le risque de désynchronisation que le lot 3 a payé
     * assez cher. Une clé inconnue du code ne rend rien à l'écran.
     *
     * Facultatif : les comptes ouverts avant ce lot ne portent pas la carte.
     */
    function recompensesValides(avant, apres) {
      return !apres.keys().hasAny(['recompenses'])
        || (apres.recompenses.keys().size() <= 24
            && (!avant.keys().hasAny(['recompenses'])
                || (apres.recompenses.keys().hasAll(avant.recompenses.keys())
                    && !apres.recompenses.diff(avant.recompenses).affectedKeys()
                         .hasAny(avant.recompenses.keys()))));
    }

    /*
     * La régularité : semaine en cours, série de jours d'affilée, record.
     *
     * **Verrouillée comme les étoiles**, et pour la même raison : ce sont des
     * compteurs que le client écrit lui-même. Le record ne redescend jamais,
     * la série ne saute pas de palier — elle repart à un ou avance d'un seul
     * cran —, et la semaine ne peut pas dépasser sept entrées. Cette dernière
     * borne est ce qui empêche le champ de grossir : c'est là qu'elle se tient,
     * pas seulement dans le code qui l'écrit.
     *
     * **Ce que les règles ne garantissent pas, et qui est assumé :** c'est
     * l'horloge du navigateur qui décide du jour. Un commercial peut donc se
     * fabriquer une série en avançant sa montre. L'enjeu est une pastille
     * d'assiduité ; l'alternative — horodatage serveur et déclencheur Cloud —
     * coûterait une fonction pour une décoration.
     *
     * Facultatif : les comptes ouverts avant ce lot ne portent pas le champ.
     */
    function assiduiteValide(avant, apres) {
      return !apres.keys().hasAny(['assiduite'])
        || (apres.assiduite.keys().hasOnly(
              ['dernierJour', 'serie', 'record', 'semaine'])
            && apres.assiduite.keys().hasAll(
                 ['dernierJour', 'serie', 'record', 'semaine'])
            && apres.assiduite.dernierJour is string
            && apres.assiduite.dernierJour.size() == 10
            && apres.assiduite.serie is int
            && apres.assiduite.serie >= 1
            && apres.assiduite.record is int
            && apres.assiduite.record >= apres.assiduite.serie
            && apres.assiduite.semaine is list
            && apres.assiduite.semaine.size() >= 1
            && apres.assiduite.semaine.size() <= 7
            // Premier passage : rien à comparer, le champ n'existait pas.
            && (!avant.keys().hasAny(['assiduite'])
                || (apres.assiduite.record >= avant.assiduite.record
                    && (apres.assiduite.serie == 1
                        || apres.assiduite.serie <= avant.assiduite.serie + 1))));
    }

    function champsEtat() {
      return ['reussies', 'tentatives', 'derniereRatee', 'majLe'];
    }

    function formeEtatValide(donnees) {
      return donnees.keys().hasOnly(champsEtat())
        && donnees.keys().hasAll(champsEtat())
        && donnees.reussies is int
        && donnees.reussies >= 0
        && donnees.tentatives is int
        && donnees.tentatives >= 1
        && donnees.reussies <= donnees.tentatives
        && donnees.derniereRatee is bool
        && horodatagePasse(donnees.majLe);
    }

    function majEtatAutorisee() {
      let avant = resource.data;
      let apres = request.resource.data;
      // Une écriture close une tentative : les deux compteurs montent, jamais
      // de plus d'un, et jamais ils ne redescendent.
      return apres.tentatives - avant.tentatives == 1
        && apres.reussies >= avant.reussies
        && apres.reussies - avant.reussies <= 1;
    }

    // --- Verdict ---------------------------------------------------------
    // Le verdict n'est pas déclaratif : il est recalculé à partir de la
    // question, sinon le client décide seul de sa réussite, et la progression
    // comme les statistiques ne valent plus rien. Même mécanisme pour
    // l'entraînement individuel et pour la session collective.

    /*
     * Les statuts qui sortent aux commerciaux.
     *
     * **« À relire » en fait partie**, et c'est ici que ça se joue : sans cette
     * ligne, une réponse à une question marquée à relire serait refusée, et le
     * commercial verrait « enregistrement incomplet » sans comprendre. Le
     * statut dit « cette question demande du travail », pas « elle ne sort
     * plus » — pour retirer une question, il y a le brouillon.
     */
    function statutsServis() {
      return ['publiee', 'aRelire'];
    }

    function verdictConforme(donnees) {
      let question = get(/databases/$(database)/documents/questions/$(donnees.questionId));
      return question != null
        && question.data.statut in statutsServis()
        // Aucune option inventée, y compris quand la réponse est fausse.
        && donnees.optionsChoisies.toSet().hasOnly(question.data.options.keys().toSet())
        // Une réponse partielle à un QCM multiple est fausse.
        && donnees.correcte == memesElements(donnees.optionsChoisies, question.data.bonnesReponses);
    }

    function selectionValide(optionsChoisies) {
      return sansDoublon(optionsChoisies) && listeBornee(optionsChoisies, 1000);
    }

    // --- Réponses individuelles ------------------------------------------

    function champsReponse() {
      return ['questionId', 'correcte', 'optionsChoisies', 'origine', 'repondueLe'];
    }

    function formeReponseValide(donnees) {
      return donnees.keys().hasOnly(champsReponse())
        && donnees.keys().hasAll(champsReponse())
        && identifiantBorne(donnees.questionId)
        && donnees.correcte is bool
        && selectionValide(donnees.optionsChoisies)
        && donnees.origine in ['entrainement', 'session']
        && horodatagePasse(donnees.repondueLe);
    }

    match /users/{uid} {
      allow get: if estProprietaire(uid);
      allow list: if false;
      allow create: if false;
      allow update: if estProprietaire(uid) && majUtilisateurAutorisee();
      allow delete: if false;

      // Aucune lecture croisée, administrateur compris. Les requêtes de
      // groupe de collections sur « reponses » ne correspondent à aucune
      // règle et sont donc refusées.
      match /reponses/{reponseId} {
        allow read: if estProprietaire(uid);
        allow create: if estProprietaire(uid)
          && formeReponseValide(request.resource.data)
          && verdictConforme(request.resource.data);
        allow update, delete: if false;
      }

      /*
       * Les prix gagnés en séance collective.
       *
       * **Le tableau meurt avec la séance, le trophée reste.** Le classement
       * est nominatif et public entre ceux qui étaient là ; le prix, lui, est
       * privé et durable. Chacun voit les siens, personne ne voit ceux des
       * autres, et rien n'agrège les prix d'une séance à l'autre.
       *
       * **Aucun client n'écrit ici, pas même le propriétaire.** Un prix qu'on
       * pourrait s'attribuer ne vaudrait rien. Seule la Cloud Function écrit,
       * hors règles, à partir des réponses de la séance. C'est le même
       * dispositif que `questionStats`.
       */
      match /prix/{prixId} {
        allow read: if estProprietaire(uid);
        allow write: if false;
      }

      // --- État par question ---------------------------------------------
      // Résumé de l'historique d'une question pour son propriétaire : ce que
      // le tirage et la maîtrise ont besoin de savoir, sans relire toutes les
      // réponses. Un document par question rencontrée, jamais plus.
      //
      // Ce que les règles garantissent : la forme, la propriété, et le fait
      // qu'un compteur ne peut que monter, d'un pas à la fois. Ce qu'elles ne
      // garantissent pas : que l'état corresponde aux réponses écrites — il
      // faudrait relire l'historique à chaque écriture. La portée d'un
      // mensonge est bornée à l'affichage du menteur : `questionStats` est
      // écrite par la Cloud Function à partir des réponses, pas des états, et
      // les réponses, elles, sont validées verdict compris.
      match /etats/{questionId} {
        allow read: if estProprietaire(uid);
        allow create: if estProprietaire(uid)
          && formeEtatValide(request.resource.data)
          && request.resource.data.tentatives == 1
          && request.resource.data.reussies <= 1;
        allow update: if estProprietaire(uid)
          && formeEtatValide(request.resource.data)
          && majEtatAutorisee();
        allow delete: if false;
      }
    }

    // --- Statistiques agrégées -------------------------------------------
    // Écrites exclusivement par la Cloud Function d'agrégation, qui utilise
    // le SDK Admin et n'est pas soumise à ces règles.

    match /questionStats/{questionId} {
      allow read: if estAdmin();
      allow write: if false;
    }

    // --- État des synchronisations ---------------------------------------
    // Compte rendu de la dernière synchronisation Airtable, écrit par la route
    // serveur avec le SDK Admin. Le back-office le lit pour afficher la date
    // et le résultat ; aucun client n'y écrit.

    match /synchronisations/{synchronisationId} {
      allow read: if estAdmin();
      allow write: if false;
    }

    // --- Sessions collectives --------------------------------------------

    /*
     * Les champs d'une séance.
     *
     * **`titre`, `animateurNom` et `ouverteLe` sont obligatoires**, comme tous
     * les autres : `hasOnly` et `hasAll` se lisent sur l'état d'après fusion,
     * si bien qu'un document qui n'en porte pas ne se met plus à jour du tout.
     * C'est voulu. Jusqu'à la mise en service, la base ne contient que de la
     * recette, effacée par `scripts/nettoyer-recette.ts` : aucune décision de
     * modèle n'est prise ici pour préserver des documents jetables.
     */
    function champsSession() {
      return ['code', 'titre', 'description', 'animateurNom', 'questionIds',
              'indexCourant', 'revelee', 'demarree', 'verrouillee', 'statut',
              'animateurUid', 'creeeLe', 'ouverteLe', 'termineeLe',
              'presentsFinal', 'effectifAttendu', 'repartition', 'repondants',
              'dureeQuestionSecondes', 'questionOuverteLe'];
    }

    /*
     * Ce que la séance annonce d'elle-même.
     *
     * **Le titre est projeté sur un mur**, donc borné et sans caractère de
     * contrôle — un titre sur deux lignes casserait la mise en page de l'écran
     * d'animation. Soixante caractères : de quoi nommer un sujet, pas de quoi
     * écrire un programme.
     *
     * **`animateurNom` est recopié depuis le compte de l'animatrice, par
     * elle-même.** Personne d'autre ne peut aller le lire : `users/{uid}` est
     * fermé à tout le monde sauf à son propriétaire, sans exception
     * administrateur. C'est le même motif que le nom porté par un marqueur de
     * présence, et pour la même raison.
     *
     * **`ouverteLe` vaut `null` tant que la séance est en attente.** Une séance
     * composée le mardi et lancée le jeudi porte deux dates ; celle-ci est
     * posée au lancement, et `creeeLe` ne bouge pas.
     */
    function annonceSeanceValide(donnees) {
      return texteBorne(donnees.titre, 60)
        && donnees.titre.matches('^[^[:cntrl:]]+$')
        // La description peut rester vide : le titre suffit à annoncer une
        // séance, et un champ obligatoire qu'on ne sait pas remplir se remplit
        // mal. Bornée quand même — elle s'affiche sur une carte étroite.
        && texteFacultatifBorne(donnees.description, 160)
        && donnees.description.matches('^[^[:cntrl:]]*$')
        && nomAffichageValide(donnees.animateurNom)
        && (donnees.ouverteLe == null || horodatagePasse(donnees.ouverteLe))
        /*
         * Ce que la séance laisse en se fermant.
         *
         * **Écrits par la Cloud Function du bilan, jamais par un client** — le
         * SDK Admin ignore ces règles. Ils figurent quand même au modèle : un
         * champ qu'aucune règle ne déclare ferait échouer `hasOnly` à la
         * première écriture cliente qui suivrait, et le refus serait
         * incompréhensible. Le client les pose à `null` et `0` à la création,
         * et n'y touche plus.
         */
        && (donnees.termineeLe == null || horodatagePasse(donnees.termineeLe))
        && donnees.presentsFinal is int
        && donnees.presentsFinal >= 0;
    }

    /*
     * Le chronomètre de la question en cours.
     *
     * **Une échéance, pas une durée.** `questionOuverteLe` est posé par
     * l'animatrice au moment où elle pousse la question ; chaque appareil
     * calcule ce qu'il reste à partir de cet instant-là. Un participant qui
     * arrive en retard, ou dont l'écran partagé a dix secondes de retard, voit
     * la même échéance que les autres — c'est la contrainte du format hybride,
     * appliquée au temps comme elle l'est à la question.
     *
     * Zéro seconde veut dire « pas de chronomètre » : une séance peut se mener
     * au rythme de la parole. Le plafond de dix minutes borne une saisie
     * accidentelle, il n'a pas d'autre sens.
     *
     * **Le chronomètre cadence, il ne ferme pas.** Ce qui ferme le vote est la
     * révélation, contrôlée plus bas sur la session elle-même. Une horloge de
     * navigateur peut dériver de quelques secondes ; une règle de sécurité ne
     * se fonde pas dessus.
     */
    function chronometreValide(donnees) {
      return donnees.dureeQuestionSecondes is int
        && donnees.dureeQuestionSecondes >= 0
        && donnees.dureeQuestionSecondes <= 600
        && horodatagePasse(donnees.questionOuverteLe);
    }

    /*
     * Le chronomètre se repose à chaque ouverture du vote.
     *
     * **Pourquoi une règle de sécurité, pour ce qui ressemble à un défaut de
     * dépôt.** Pendant une séance réelle, `rouvrirLeVote` a écrit
     * `revelee: false` sans reposer `questionOuverteLe`. Le vote rouvrait, le
     * chronomètre restait sur l'échéance précédente — déjà dépassée —, et la
     * salle voyait « temps écoulé » sur une question qu'on venait tout juste de
     * lui rendre. Les règles autorisaient cette écriture : `questionOuverteLe`
     * y est permis, il n'y était pas exigé. **Aucun test de règles ne pouvait
     * donc la voir, quel que soit leur nombre.**
     *
     * Trois gestes ouvrent le vote sur une question, et tous les trois doivent
     * reposer l'échéance :
     *
     *   - on change de question — `indexCourant` bouge ;
     *   - on rouvre le vote sur la question en cours — `revelee` repasse à faux ;
     *   - on met la séance en cours — lancement d'une séance préparée, ou sortie
     *     de pause. Une pause de dix minutes laisserait sinon la salle
     *     reprendre sur une échéance périmée.
     *
     * Les autres gestes ne la déclenchent pas et n'ont pas à reposer l'échéance :
     * révéler, mettre en pause, terminer, abandonner.
     *
     * `affectedKeys()` ne retient que les clés dont la valeur change
     * réellement : réécrire le même instant ne satisfait pas la contrainte.
     */
    function ouvreLeVote() {
      return request.resource.data.indexCourant != resource.data.indexCourant
        || (resource.data.revelee == true && request.resource.data.revelee == false)
        || (resource.data.statut != 'encours' && request.resource.data.statut == 'encours');
    }

    function chronometreRepose() {
      return !ouvreLeVote()
        || request.resource.data.diff(resource.data)
             .affectedKeys().hasAll(['questionOuverteLe']);
    }

    /*
     * La répartition des réponses, écrite sur la session par l'animatrice au
     * moment de la révélation.
     *
     * **Pourquoi elle vit ici et non dans le navigateur du participant.** Les
     * réponses de session ne sont lisibles que par l'animatrice et par leur
     * propriétaire — un participant ne voit pas qui a répondu quoi, décision du
     * lot 1. Il ne peut donc pas calculer la répartition lui-même : il faut
     * qu'elle lui soit donnée, déjà agrégée et sans identifiant.
     *
     * La liste est alignée sur `ordreOptions` de la question en cours : un
     * entier par option, dans le même ordre. Elle est remplacée à chaque
     * révélation et vidée au passage à la question suivante. Aucun nom, aucun
     * uid : ce qui n'entre pas ici ne peut pas en sortir.
     */
    function repartitionValide(donnees) {
      return donnees.repartition is list
        // Une question a au moins deux options ; le plafond couvre large sans
        // permettre d'utiliser ce champ comme d'un sac.
        && donnees.repartition.size() <= 40
        && donnees.repondants is int
        && donnees.repondants >= 0;
    }

    function sessionValide(donnees) {
      return donnees.keys().hasOnly(champsSession())
        && donnees.keys().hasAll(champsSession())
        && repartitionValide(donnees)
        && chronometreValide(donnees)
        && annonceSeanceValide(donnees)
        // Le code est lu à voix haute puis saisi à la main.
        && texteBorne(donnees.code, 12)
        && donnees.questionIds is list
        && donnees.questionIds.size() > 0
        && sansDoublon(donnees.questionIds)
        && listeBornee(donnees.questionIds, 4000)
        && donnees.indexCourant is int
        && donnees.indexCourant >= 0
        && donnees.indexCourant < donnees.questionIds.size()
        && donnees.revelee is bool
        /*
         * **Trois moments, pas deux.**
         *
         * `attente` : composée, pas ouverte — le code ne vaut rien.
         * `encours` + `demarree` faux : la salle est ouverte, on attend le
         *   monde. C'est la salle d'attente, où le code se dicte.
         * `encours` + `demarree` vrai : la première question est posée.
         *
         * Le statut seul ne distinguait pas les deux derniers, et c'est
         * précisément entre eux que vit l'écran de salle d'attente.
         */
        && donnees.demarree is bool
        /*
         * La porte de la salle.
         *
         * **Un booléen sur la séance, et rien de plus.** Il ne dit pas qui est
         * entré ni qui a été refusé : il dit si la porte accepte encore
         * quelqu'un. Une séance neuve l'a à faux — une salle s'ouvre ouverte —,
         * et il se pose et se défait autant de fois que nécessaire, comme la
         * pause. Le seul endroit où il agit est la création d'un marqueur de
         * présence, plus bas.
         */
        && donnees.verrouillee is bool
        /*
         * L'effectif attendu, dénominateur de « 8 sur 10 ».
         *
         * Il ne se devine pas : l'outil n'a pas de liste d'invités, le code est
         * dit à voix haute et quiconque l'entend entre. Noémie le déclare.
         * Zéro vaut « non déclaré », et l'écran n'affiche alors aucun
         * dénominateur plutôt qu'un chiffre inventé. Le plafond borne une
         * saisie accidentelle, il n'a pas d'autre sens.
         */
        && donnees.effectifAttendu is int
        && donnees.effectifAttendu >= 0
        && donnees.effectifAttendu <= 500
        /*
         * Les cinq états d'une séance.
         *
         * `attente`    — préparée, pas encore lancée. C'est le cas normal :
         *                Noémie compose le mardi, elle lance le jeudi.
         * `encours`    — la salle vote.
         * `pause`      — suspendue. Le vote est fermé, l'écran des
         *                participants le dit, et la séance reprend où elle en
         *                était. Une réunion qui déborde, dix minutes de
         *                battement : mieux vaut une pause qu'une question
         *                figée sur dix téléphones.
         * `terminee`   — close et classée, même écourtée. Cinq questions sur
         *                huit font un classement légitime : c'est ce qui a été
         *                joué.
         * `abandonnee` — close et **non classée**. La visioconférence tombe,
         *                une question se révèle inutilisable : le résultat ne
         *                voudrait rien dire. Les réponses déjà données restent
         *                dans la progression de chacun — elles étaient
         *                réelles —, seul le classement collectif n'a pas lieu.
         */
        && donnees.statut in ['attente', 'encours', 'pause', 'terminee', 'abandonnee']
        && identifiantBorne(donnees.animateurUid)
        && horodatagePasse(donnees.creeeLe);
    }

    function champsReponseSession() {
      return ['uid', 'questionId', 'optionsChoisies', 'correcte', 'repondueLe'];
    }

    function formeReponseSessionValide(donnees) {
      return donnees.keys().hasOnly(champsReponseSession())
        && donnees.keys().hasAll(champsReponseSession())
        && identifiantBorne(donnees.uid)
        && identifiantBorne(donnees.questionId)
        && donnees.correcte is bool
        && selectionValide(donnees.optionsChoisies)
        && horodatagePasse(donnees.repondueLe);
    }

    /*
     * Qui était dans la salle.
     *
     * **Ce document est la clé de tout le classement.** Les règles ne savent
     * pas restreindre la lecture d'une session « aux participants » : elles ne
     * peuvent pas inspecter les clauses d'une requête, et l'identifiant d'une
     * réponse porte le numéro de question, donc on ne peut pas tester son
     * existence sans le connaître. Un marqueur par participant, à son propre
     * uid, se teste en revanche d'un `exists()`.
     *
     * **On ne peut se déclarer présent que pendant la séance.** Le marqueur
     * n'est créable que sur une session `encours` : quelqu'un qui a manqué le
     * jeudi ne peut pas s'inscrire après coup pour lire le classement. C'est
     * l'approximation la plus proche de « il était dans la pièce » qu'une règle
     * sache exprimer, et elle est suffisante.
     *
     * **Il porte aussi le nom d'affichage**, et c'est le participant qui
     * l'écrit. Sans cela, l'animatrice ne saurait pas nommer les votes : elle
     * lit les réponses, qui ne portent qu'un uid, et `users/{uid}` lui est
     * fermé — sans exception administrateur, décision du lot 1. Chacun publie
     * donc son propre nom, pour cette séance, et personne ne va le chercher
     * dans ses données privées.
     */
    /*
     * Le nom projeté sur un mur.
     *
     * On borne ce qui est bornable : la longueur, et l'absence de caractères de
     * contrôle — retour à la ligne, tabulation, caractères invisibles. Un nom
     * sur deux lignes casse la mise en page de toute la liste ; un caractère de
     * contrôle ne s'affiche pas mais compte dans la longueur.
     *
     * **Pas de filtre de contenu.** Dix collègues se connaissent, et une liste
     * de mots interdits serait à la fois contournable et vexante.
     */
    function nomAffichageValide(nom) {
      return texteBorne(nom, 32) && nom.matches('^[^[:cntrl:]]+$');
    }

    function participantValide(donnees) {
      return donnees.keys().hasOnly(['nom', 'rejointLe', 'avatar', 'presence'])
        && donnees.keys().hasAll(['nom', 'rejointLe', 'avatar', 'presence'])
        && nomAffichageValide(donnees.nom)
        /*
         * En salle ou en visio.
         *
         * **La séance est hybride, et l'animatrice doit le savoir.** Une partie
         * de la salle voit l'écran projeté avec plusieurs secondes de retard :
         * savoir qui est devant elle et qui est au bout d'un lien change la
         * façon de mener la séance. Chacun le déclare pour lui-même, comme son
         * nom et sa couleur.
         */
        && donnees.presence in ['salle', 'visio']
        // Recopié depuis le document utilisateur pour la même raison que le
        // nom : l'animatrice doit pouvoir dessiner la salle sans lire les
        // données privées de qui que ce soit.
        && donnees.avatar in ['bleu', 'turquoise', 'vert', 'jaune',
                              'orange', 'rose', 'violet', 'encre']
        && horodatagePasse(donnees.rejointLe);
    }

    /**
     * L'identifiant d'un document qui m'appartient : `{monUid}_{questionId}`.
     * Un préfixe, séparateur compris, pour qu'un uid ne puisse pas en préfixer
     * un autre.
     */
    function estMonIdentifiant(identifiant) {
      return identifiant.size() > request.auth.uid.size()
        && identifiant[0:request.auth.uid.size() + 1] == request.auth.uid + '_';
    }

    function estPresent(sessionId) {
      return exists(
        /databases/$(database)/documents/sessions/$(sessionId)/participants/$(request.auth.uid));
    }

    /*
     * La salle accepte-t-elle encore quelqu'un ?
     *
     * **Deux conditions, et une seule porte.** La séance doit être en cours ou
     * en pause — on ne s'inscrit pas à une séance close pour en lire le
     * classement —, et la porte ne doit pas avoir été fermée par l'animatrice.
     *
     * **Ce que cette fonction ne garde pas est aussi important que ce qu'elle
     * garde.** Elle n'est appelée qu'à la *création* d'un marqueur de présence.
     * Qui est déjà dans la salle a déjà le sien : il vote, il apparaît au
     * classement, il corrige son nom, et rien ici ne le concerne. Verrouiller
     * ferme la porte, cela ne vide pas la pièce.
     *
     * `get('verrouillee', false)` plutôt que l'accès direct : une séance écrite
     * par le SDK Admin — la Cloud Function du bilan — ne passe pas par
     * `sessionValide`, et une porte absente est une porte ouverte.
     */
    function salleOuverte(sessionId) {
      return get(/databases/$(database)/documents/sessions/$(sessionId)).data.statut
               in ['encours', 'pause']
        && get(/databases/$(database)/documents/sessions/$(sessionId))
             .data.get('verrouillee', false) == false;
    }

    /*
     * La porte est-elle fermée ?
     *
     * **C'est l'exacte négation de `salleOuverte`, et il fallait la nommer.**
     * On ne frappe qu'à une porte close : tant que la salle accepte, le bouton
     * « Rejoindre » est le bon geste, et un appel serait du bruit sur l'écran
     * de l'animatrice. La séance doit tout de même être vivante — on ne frappe
     * pas à une séance terminée.
     */
    function porteFermee(sessionId) {
      return get(/databases/$(database)/documents/sessions/$(sessionId)).data.statut
               in ['encours', 'pause']
        && get(/databases/$(database)/documents/sessions/$(sessionId))
             .data.get('verrouillee', false) == true;
    }

    function appelValide(donnees) {
      return donnees.keys().hasOnly(['nom', 'avatar', 'demandeLe'])
        && donnees.keys().hasAll(['nom', 'avatar', 'demandeLe'])
        && nomAffichageValide(donnees.nom)
        // Même palette que les présences : l'appelant porte déjà sa pastille
        // avant d'entrer, et il la garde une fois entré.
        && donnees.avatar in ['bleu', 'turquoise', 'vert', 'jaune',
                              'orange', 'rose', 'violet', 'encre']
        && horodatagePasse(donnees.demandeLe);
    }

    /*
     * **Le podium de régularité — l'écart assumé de l'écran 04b.**
     *
     * La maquette dessine un classement complet de l'équipe sur le taux de
     * maîtrise. On publie un podium sur la **régularité**, et ces règles sont
     * ce qui rend la différence réelle plutôt que décorative.
     *
     * **Deux documents, deux portées.**
     *
     * `classements/regularite` ne contient que les nommés — trois valeurs au
     * plus, jamais une série à zéro, jamais moins de trois séries vivantes. Il
     * est lisible par le domaine : c'est le point de la fonctionnalité.
     *
     * `classements/regularite/personnel/{uid}` porte le rang de chacun et
     * l'écart avec la valeur du dessus. **Lui seul le lit.** C'est ce qui
     * permet d'annoncer « deux jours de plus et vous passez sixième » sans que
     * personne n'apprenne le rang de personne.
     *
     * **`list` est refusé partout, et c'est la clause décisive.** Sans elle,
     * lister `personnel` reconstituerait le classement complet — exactement ce
     * qu'on refuse d'afficher. Aucune distribution n'est publiée non plus,
     * même anonyme : sur une équipe de dix, un zéro dans une liste se devine.
     *
     * **Aucune écriture client, pas même par son propriétaire.** Un rang qu'on
     * peut s'attribuer ne vaut rien. La Cloud Function écrit par le SDK Admin,
     * hors de ces règles ; cette autorisation dit qui aurait le droit, et
     * ferme la porte à tous les autres.
     *
     * **Aucun taux de maîtrise n'entre ici.** Il ne sort pas de `users/{uid}`,
     * et le document publié ne porte que nom, couleur, série et date.
     */
    match /classements/{classement} {
      allow get: if domaineAutorise();
      allow list: if false;
      allow write: if false;

      match /personnel/{uid} {
        allow get: if estProprietaire(uid);
        allow list: if false;
        allow write: if false;
      }
    }

    match /sessions/{sessionId} {
      allow read: if domaineAutorise();
      allow create: if estAdmin()
        && sessionValide(request.resource.data)
        && request.resource.data.animateurUid == request.auth.uid;
      allow update: if estAdmin()
        && sessionValide(request.resource.data)
        && resource.data.animateurUid == request.auth.uid
        && request.resource.data.animateurUid == resource.data.animateurUid
        && chronometreRepose();
      allow delete: if estAdmin() && resource.data.animateurUid == request.auth.uid;

      // Chaque participant n'écrit que sa propre réponse, une seule fois,
      // sous un identifiant qui porte son uid. Il ne relit que la sienne :
      // seul l'animateur voit l'ensemble, pour établir la répartition.
      // Le verdict est vérifié comme en entraînement individuel : une réponse
      // donnée en session alimente la progression, elle doit valoir autant.
      match /reponses/{reponseId} {
        /*
         * **« Je n'ai pas encore répondu » doit être une réponse, pas une
         * erreur.**
         *
         * Le contrôle portait sur `resource.data.uid`. Sur un document qui
         * n'existe pas, `resource` est nul : la lecture était donc refusée —
         * non pas parce qu'elle était interdite, mais parce qu'il n'y avait
         * rien à lire. `chargerMaReponse`, qui demande précisément « ai-je déjà
         * répondu à celle-ci ? », recevait un refus de permission sur chaque
         * question à laquelle personne n'avait encore répondu. Le `catch` de
         * l'écran l'absorbait, et ça marchait par accident.
         *
         * Le contrôle porte donc sur l'identifiant du document, qui vaut
         * `{uid}_{questionId}` — la création l'impose plus bas, la mise à jour
         * et la suppression sont fermées, et aucun autre écrivain n'existe.
         * C'est exactement le même droit, exprimé sur le chemin plutôt que sur
         * le contenu, et il se prononce sur l'absence.
         *
         * **L'absence ne fuit pas pour autant** : on ne peut interroger que les
         * identifiants qui commencent par son propre uid. Personne ne teste si
         * un collègue a déjà voté.
         */
        allow get: if estAnimateur(sessionId)
          || (domaineAutorise() && estMonIdentifiant(reponseId));
        /*
         * **La liste nominative ne survit pas à la séance.**
         *
         * Pendant la séance, l'animatrice lit les votes de la salle : c'est
         * l'exercice, et les participants sont dans la même pièce. Une fois la
         * séance close, ce droit n'a plus d'objet — et le garder ferait de
         * chaque séance passée une archive nominative de qui a raté quoi,
         * exactement ce que l'isolation des scores interdit partout ailleurs.
         *
         * L'historique se lit donc sur `bilan`, agrégé et sans identifiant,
         * écrit par la Cloud Function à la fin de la séance.
         */
        allow list: if estAnimateur(sessionId)
          && get(/databases/$(database)/documents/sessions/$(sessionId)).data.statut
               in ['encours', 'pause'];
        // **Pas de réponse après la révélation.** Une fois la bonne réponse
        // affichée, répondre juste ne coûte plus rien : la réponse alimenterait
        // la progression individuelle et `questionStats` d'un point gagné sans
        // l'avoir cherché. Le retardataire voit donc la correction, il ne vote
        // pas dessus. Le contrôle porte sur la session, pas sur le client : une
        // fenêtre restée ouverte ne doit pas pouvoir voter en différé.
        //
        // La lecture supplémentaire coûte un document par réponse écrite. À
        // dix participants et huit questions, c'est quatre-vingts lectures pour
        // une séance entière.
        allow create: if domaineAutorise()
          && request.resource.data.uid == request.auth.uid
          && reponseId == request.auth.uid + '_' + request.resource.data.questionId
          && formeReponseSessionValide(request.resource.data)
          && verdictConforme(request.resource.data)
          && get(/databases/$(database)/documents/sessions/$(sessionId)).data.revelee == false
          && get(/databases/$(database)/documents/sessions/$(sessionId)).data.statut == 'encours';
        allow update: if false;
        /*
         * **Une séance abandonnée efface ses réponses.**
         *
         * Elles ne servaient qu'au classement, et il n'y en aura pas. Elles
         * sont déjà invisibles de tous une fois la séance close — `list` plus
         * haut est conditionné à `encours` ou `pause` — mais invisible n'est
         * pas effacé, et une séance qu'on abandonne ne laisse rien de nominatif
         * derrière elle.
         *
         * **Trois verrous, et chacun sert.** L'animatrice de cette séance et
         * personne d'autre ; sur une séance `abandonnee` et pas une autre ;
         * jamais sur une séance terminée, dont le classement se calcule
         * précisément à partir de ces réponses.
         *
         * **La progression individuelle n'est pas concernée**, et ne peut pas
         * l'être : `users/{uid}/reponses` est fermé en suppression, et les
         * compteurs d'`etats` ne redescendent pas. Ces réponses-là étaient
         * réelles — décision du lot 7, promise en toutes lettres à l'écran.
         *
         * En pratique c'est la Cloud Function du bilan qui efface, par le SDK
         * Admin, donc hors de ces règles. Cette autorisation dit néanmoins qui
         * aurait le droit, et ferme la porte à tous les autres.
         */
        allow delete: if estAnimateur(sessionId)
          && get(/databases/$(database)/documents/sessions/$(sessionId)).data.statut
               == 'abandonnee';
      }

      match /participants/{participantUid} {
        // L'animatrice lit toute la salle : c'est ce qui lui permet de nommer
        // les votes en direct. Un participant ne lit que son propre marqueur.
        allow get: if estAnimateur(sessionId) || estProprietaire(participantUid);
        /*
         * **Qui est déjà dans la salle, avant même d'avoir rejoint.**
         *
         * L'écran d'accès annonce les présents : c'est le sens d'une séance
         * collective, et c'est ce que l'écran projeté affiche déjà devant tout
         * le monde. La liste s'ouvre donc au domaine — mais seulement pendant
         * la séance.
         *
         * **La clause de statut n'est pas une précaution de plus, c'est la
         * clause qui rend l'ouverture acceptable.** C'est la seule collection
         * nominative de l'outil. Sans elle, chaque séance passée deviendrait
         * une archive permanente de qui était là quel jeudi, lisible par tout
         * le domaine — exactement ce que la règle jumelle interdit quelques
         * lignes plus haut pour la liste des réponses, et pour la même raison.
         * Pendant la séance, cette liste ne dit rien que la pièce ne voie ;
         * après, il n'en reste rien.
         *
         * **Ouvrir la lecture n'ouvre pas la présence.** La création reste
         * réservée au propriétaire du marqueur, et `estPresent()` — la barrière
         * du classement — est un `exists()`, pas une liste. Personne ne devient
         * présent pour avoir su lire.
         */
        allow list: if estAnimateur(sessionId)
          || (domaineAutorise()
              && get(/databases/$(database)/documents/sessions/$(sessionId)).data.statut
                   in ['encours', 'pause']);
        /*
         * **Toute la portée du verrou tient sur cette ligne, et c'est voulu.**
         * Pendant une pause aussi on entre : c'est le moment où un retardataire
         * rattrape la salle. Après la fin, non — on ne s'inscrit pas à une
         * séance close pour en lire le classement. Et pas non plus quand
         * l'animatrice a fermé la porte : voir `salleOuverte`.
         */
        allow create: if domaineAutorise()
          && estProprietaire(participantUid)
          && participantValide(request.resource.data)
          && salleOuverte(sessionId);
        /*
         * Le nom peut changer en cours de séance, la présence non.
         *
         * **Cette règle est la réponse à « que deviennent ceux qui sont déjà
         * là ».** Elle ne regarde ni le statut de la séance ni la porte : un
         * présent reste un présent. C'est aussi par elle que passe la
         * reconnexion d'un onglet rechargé — `rejoindre` fusionne alors sans
         * réécrire `rejointLe`, faute de quoi une reconnexion serait refusée.
         */
        allow update: if estProprietaire(participantUid)
          && participantValide(request.resource.data)
          && request.resource.data.rejointLe == resource.data.rejointLe;
        allow delete: if false;
      }

      /*
       * **Frapper à la porte — le seul canal qui remonte de la salle.**
       *
       * Tout le reste descend : la question, la révélation, le classement. Un
       * participant n'écrit que ce qui le concerne à l'intérieur de la séance —
       * sa présence, sa réponse. Ici, quelqu'un qui n'est *pas* dans la pièce
       * adresse une demande à l'animatrice, et c'est la première fois.
       *
       * **Un document par personne, identifié par son uid.** Frapper deux fois
       * réécrit le même document : il n'y a pas de file à dédupliquer, et dix
       * personnes qui insistent ne produisent pas dix lignes. C'est la réponse
       * la plus simple à « il ne doit pas frapper vingt fois ».
       *
       * **`list` ne s'ouvre pas au domaine, et c'est la différence avec les
       * présences.** Celles-ci sont lisibles par toute la salle parce que
       * l'écran projeté les affiche déjà : la liste ne dit rien que la pièce ne
       * voie. Un appel dit l'inverse — qui est resté dehors — et cela ne
       * regarde que l'animatrice. Personne d'autre n'apprend qui a frappé.
       *
       * **Rien ne s'archive.** L'appel s'efface quand la personne entre, quand
       * l'animatrice l'écarte, et avec la séance. Il n'existe aucun état où
       * l'outil garde la trace des retards d'un jeudi.
       *
       * **Ce que ces règles ne tiennent pas, et on l'assume.** Elles ne
       * vérifient pas que l'appelant connaît le code : le document de séance
       * est lisible par tout le domaine, l'identifiant s'y trouve, et le code
       * est une commodité, pas un secret. Ce qu'elles tiennent : un membre du
       * domaine, une porte effectivement fermée, quelqu'un qui n'est pas déjà
       * entré, et son seul document.
       */
      match /appels/{appelantUid} {
        allow get: if estAnimateur(sessionId) || estProprietaire(appelantUid);
        allow list: if estAnimateur(sessionId);

        /*
         * `create` et `update` portent la même charge : le second est le
         * rappel, une minute plus tard, qui ne fait que repousser `demandeLe`.
         *
         * **`!estPresent` ferme la porte dans l'autre sens.** Qui est entré n'a
         * plus rien à demander, et un appel laissé là ferait apparaître dans la
         * liste quelqu'un qui est assis dans la salle.
         */
        allow create, update: if estProprietaire(appelantUid)
          && appelValide(request.resource.data)
          && porteFermee(sessionId)
          && !estPresent(sessionId);

        // L'animatrice écarte, l'appelant se rétracte — ou son entrée efface
        // son propre appel.
        allow delete: if estAnimateur(sessionId) || estProprietaire(appelantUid);
      }

      /*
       * Le classement de la séance.
       *
       * **Les absents ne le voient pas.** C'est une décision de produit, pas
       * une contrainte technique : ils n'étaient pas là. La lecture exige donc
       * un marqueur de présence, posé pendant la séance et pas après.
       *
       * **Aucun client ne l'écrit.** Il est calculé et posé par la Cloud
       * Function quand la séance se termine, à partir des réponses. La seule
       * façon d'être premier est de l'avoir été — comme pour `questionStats`,
       * et pour la même raison.
       */
      /*
       * Le bilan de la séance : ce qui a été posé, et ce qui a trébuché.
       *
       * **Aucun identifiant.** Un compte de réponses et un compte d'échecs par
       * question, et rien d'autre. C'est ce dont Noémie a besoin pour préparer
       * le jeudi suivant — ce qui a trébuché la semaine dernière détermine ce
       * qu'elle repose —, et c'est tout ce qu'elle peut en savoir.
       *
       * Réservé à l'animatrice de la séance : les participants ont leur
       * classement, ils n'ont pas à relire les taux d'échec de la salle.
       * Écriture fermée à tout client, comme le classement.
       */
      match /bilan/{document} {
        allow read: if estAnimateur(sessionId);
        allow write: if false;
      }

      match /classement/{document} {
        allow read: if domaineAutorise() && (estPresent(sessionId) || estAnimateur(sessionId));
        allow write: if false;
      }
    }

    // Tout le reste est refusé.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
